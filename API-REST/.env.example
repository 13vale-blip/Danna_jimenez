# Copie este archivo como .env y reemplace los valores de relleno.
# Cadena de conexion de MongoDB Atlas (Connect -> Drivers -> Node.js).
# El archivo .env NO se sube al repositorio.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.xxxxx.mongodb.net/inasistencias?retryWrites=true&w=majority

# Origen del front-end autorizado por CORS (opcional; por defecto http://localhost:8080)
# ORIGEN_FRONTEND=http://localhost:8080
